---
// Canonical layout. Single page — theme is switched client-side by flipping
// the `data-theme` attribute on <html> (light|dark). Dark is the default
// (chosen design). No per-route variants.
import "../styles/global.css";
import { profile, skills, education } from "../data/site";
interface Props { title?: string; }
const { title } = Astro.props;
const htmlTitle = title ?? `${profile.firstName} ${profile.lastName} · ${profile.title}`;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <script is:inline>
      // Apply saved theme before first paint to avoid flash. Default: dark.
      (function () {
        var t = "dark";
        try { t = localStorage.getItem("theme") || "dark"; } catch (e) {}
        document.documentElement.setAttribute("data-theme", t === "light" ? "light" : "dark");
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{htmlTitle}</title>
    <meta name="description" content={profile.summary} />
    <meta name="author" content={profile.fullName} />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content="Astro" />
    <meta name="theme-color" content="#0b0b14" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f7fb" media="(prefers-color-scheme: light)" />
    <link rel="canonical" href="https://rakesh.link/" />
    <link rel="icon" type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='20' fill='%232563eb'/%3E%3Ctext x='50' y='68' font-size='52' text-anchor='middle' fill='white' font-family='Arial' font-weight='bold'%3ERL%3C/text%3E%3C/svg%3E" />

    <!-- Open Graph -->
    <meta property="og:site_name" content={profile.fullName} />
    <meta property="og:title" content={htmlTitle} />
    <meta property="og:description" content={profile.summary} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://rakesh.link/" />
    <meta property="og:image" content="https://rakesh.link/og-default.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.fullName} — ${profile.title}`} />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={htmlTitle} />
    <meta name="twitter:description" content={profile.summary} />
    <meta name="twitter:image" content="https://rakesh.link/og-default.png" />
    <meta name="twitter:image:alt" content={`${profile.fullName} — ${profile.title}`} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: profile.fullName,
      url: "https://rakesh.link/",
      image: "https://rakesh.link/og-default.png",
      jobTitle: profile.title,
      email: "mailto:" + profile.email,
      telephone: profile.phone,
      address: { "@type": "PostalAddress", addressLocality: "Hyderabad", addressCountry: "IN" },
      sameAs: [profile.linkedin, profile.github, profile.twitter, profile.website],
      knowsAbout: skills.flatMap((s) => s.items),
      worksFor: { "@type": "Organization", name: "Sanofi" },
      alumniOf: education.map((e) => ({ "@type": "CollegeOrUniversity", name: e.school })),
    })} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
    <script is:inline>
      // Theme toggle: flips <html data-theme> in place, persists choice.
      document.querySelectorAll("[data-theme-toggle]").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var html = document.documentElement;
          var next = html.getAttribute("data-theme") === "light" ? "dark" : "light";
          html.setAttribute("data-theme", next);
          try { localStorage.setItem("theme", next); } catch (e) {}
        });
      });

      // reveal-on-scroll
      const io = new IntersectionObserver((es) => {
        es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } });
      }, { threshold: 0.12 });
      document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));

      // mobile nav
      const btn = document.querySelector("#menu-btn");
      const links = document.querySelector("#nav-links");
      btn?.addEventListener("click", () => links?.classList.toggle("open"));
      links?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => links.classList.remove("open")));
    </script>
  </body>
</html>
