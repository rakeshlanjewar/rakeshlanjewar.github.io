---
// Canonical layout. Single page — theme is switched client-side by flipping
// the `data-theme` attribute on <html> (light|dark). Dark is the default
// (chosen design). No per-route variants.
import "../styles/global.css";
import { profile } from "../data/site";
interface Props { title?: string; }
const { title } = Astro.props;
const htmlTitle = title ?? `${profile.firstName} ${profile.lastName} · ${profile.title}`;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <script is:inline>
      // Apply saved theme before first paint to avoid flash. Default: dark.
      (function () {
        var t = "dark";
        try { t = localStorage.getItem("theme") || "dark"; } catch (e) {}
        document.documentElement.setAttribute("data-theme", t === "light" ? "light" : "dark");
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{htmlTitle}</title>
    <meta name="description" content={profile.summary} />
    <link rel="icon" type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='20' fill='%232563eb'/%3E%3Ctext x='50' y='68' font-size='52' text-anchor='middle' fill='white' font-family='Arial' font-weight='bold'%3ERL%3C/text%3E%3C/svg%3E" />
    <meta property="og:title" content={htmlTitle} />
    <meta property="og:description" content={profile.summary} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://rakesh.link" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
    <script is:inline>
      // Theme toggle: flips <html data-theme> in place, persists choice.
      document.querySelectorAll("[data-theme-toggle]").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var html = document.documentElement;
          var next = html.getAttribute("data-theme") === "light" ? "dark" : "light";
          html.setAttribute("data-theme", next);
          try { localStorage.setItem("theme", next); } catch (e) {}
        });
      });

      // reveal-on-scroll
      const io = new IntersectionObserver((es) => {
        es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } });
      }, { threshold: 0.12 });
      document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));

      // mobile nav
      const btn = document.querySelector("#menu-btn");
      const links = document.querySelector("#nav-links");
      btn?.addEventListener("click", () => links?.classList.toggle("open"));
      links?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => links.classList.remove("open")));
    </script>
  </body>
</html>
