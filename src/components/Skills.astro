---
import { skills } from "../data/site";
---

<section id="skills" class="sec" style="background:color-mix(in srgb, var(--surface) 45%, transparent);border-block:1px solid var(--border)">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <span class="sec-num">02.</span><h2>Skills</h2><div class="rule"></div>
    </div>
    <div class="skills-grid">
      {skills.map((g) => (
        <div class="skill-card" data-reveal>
          <h3>{g.group}</h3>
          <div class="chips">
            {g.items.map((i) => <span class="chip">{i}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
