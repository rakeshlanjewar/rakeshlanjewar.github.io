---
import { profile } from "../data/site";
const ic = (p: string) => `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="${p}"/></svg>`;
const icon = {
  mail: "M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z",
  github: "M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.15c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.66.41.36.78 1.06.78 2.14v3.17c0 .3.2.67.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z",
  linkedin: "M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0z",
  website: "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm6.9 6h-3a15 15 0 0 0-1.4-3.6A8 8 0 0 1 18.9 8zM12 4c.9 1.2 1.7 2.6 2.1 4H9.9c.4-1.4 1.2-2.8 2.1-4zM4.3 14a8 8 0 0 1 0-4h3.6a17 17 0 0 0 0 4H4.3zm1.1 2h3a15 15 0 0 0 1.4 3.6A8 8 0 0 1 5.4 16zM12 20c-.9-1.2-1.7-2.6-2.1-4h4.2c-.4 1.4-1.2 2.8-2.1 4zm3.1-6H8.9a15 15 0 0 1 0-4h6.2a15 15 0 0 1 0 4zm.6 5.6a15 15 0 0 0 1.4-3.6h3a8 8 0 0 1-4.4 3.6zM16.7 14a17 17 0 0 0 0-4h3.6a8 8 0 0 1 0 4h-3.6z",
  download: "M11 5h2v8.17l3.59-3.58L18 11l-6 6-6-6 1.41-1.41L11 13.17V5zM5 19h14v2H5v-2z",
};
const socials = [
  { label: "GitHub", href: profile.github, d: icon.github },
  { label: "LinkedIn", href: profile.linkedin, d: icon.linkedin },
  { label: "Website", href: profile.website, d: icon.website },
  { label: "Email", href: "mailto:" + profile.email, d: icon.mail },
];
---

<section id="contact" class="sec">
  <div class="wrap">
    <div class="contact-card" data-reveal>
      <h2>Let's build something <span class="grad" style="background:linear-gradient(100deg,var(--accent),var(--accent-2));-webkit-background-clip:text;background-clip:text;color:transparent">great</span> together.</h2>
      <p class="sub">I'm open to senior full-stack and AI-engineering roles, collaborations, and interesting problems. My inbox is always open — I'll get back to you promptly.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={"mailto:" + profile.email}><span set:html={ic(icon.mail)}></span> {profile.email}</a>
        <a class="btn btn-ghost" href="/Rakesh_Lanjewar_CV_July2026.pdf" download><span set:html={ic(icon.download)}></span> Resume</a>
      </div>
      <div class="socials">
        {socials.map((s) => <a class="social" href={s.href} target="_blank" rel="noopener"><span set:html={ic(s.d)}></span> {s.label}</a>)}
      </div>
    </div>
  </div>
</section>
