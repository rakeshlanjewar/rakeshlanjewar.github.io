---
import { experience } from "../data/site";
const fmt = (s: string, endLabel: string) => {
  const d = (s: string) => new Date(s + "-01").toLocaleDateString("en-US", { month: "short", year: "numeric" });
  return endLabel === "Present" ? `${d(experience[0].start)} — Present` : `${d(s)} — ${d(endLabel)}`;
};
---

<section id="experience" class="sec" style="background:color-mix(in srgb, var(--surface) 45%, transparent);border-block:1px solid var(--border)">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <span class="sec-num">04.</span><h2>Experience</h2><div class="rule"></div>
    </div>
    <div class="timeline">
      {experience.map((e) => (
        <div class="t-item" data-reveal>
          <span class="t-dot"></span>
          <div class="t-head">
            <span class="t-role">{e.role}</span>
            <span class="t-loc">· {e.org}</span>
            <span class="t-range">{fmt(e.start, e.endLabel ?? e.end)}</span>
          </div>
          <div style="color:var(--text-3);font-size:.9rem;margin-top:2px">{e.location}</div>
          <ul class="t-bullets">
            {e.bullets.map((b) => {
              const m = b.match(/^(.+?)\s*—\s*(.+)$/);
              return m ? <li><strong>{m[1]}</strong> — {m[2]}</li> : <li>{b}</li>;
            })}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
