---
import { profile } from "../data/site";
const file = "/Rakesh_Lanjewar_CV_July2026.pdf";
const roleJson = JSON.stringify(profile.titleOptions);
const ic = (p: string) =>
  `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="${p}"/></svg>`;
const icon = {
  github: "M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.15c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.66.41.36.78 1.06.78 2.14v3.17c0 .3.2.67.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z",
  linkedin: "M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0z",
  mail: "M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z",
  download: "M11 5h2v8.17l3.59-3.58L18 11l-6 6-6-6 1.41-1.41L11 13.17V5zM5 19h14v2H5v-2z",
  pin: "M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z",
};
---

<section class="hero grid-bg">
  <div class="wrap hero-inner">
    <span class="eyebrow"><span class="pulse"></span> 8+ years · Full Stack · AI Engineering</span>
    <h1>Hi, I'm <span class="grad">{profile.firstName} {profile.lastName}</span>.</h1>
    <div class="roles" data-roles={roleJson}></div>
    <p class="lede">Senior software engineer building scalable full-stack systems on Node.js, NestJS and Vue, with production AI-agent integrations — currently at Sanofi.</p>
    <div class="hero-cta">
      <a class="btn btn-primary" href={profile.linkedin} target="_blank" rel="noopener">
        <span set:html={ic(icon.linkedin)}></span> Let's connect
      </a>
      <a class="btn btn-ghost" href={file} download>
        <span set:html={ic(icon.download)}></span> Download CV
      </a>
    </div>
    <div class="hero-meta">
      <span title="Location"><span set:html={ic(icon.pin)}></span> {profile.location}</span>
      <a href={"mailto:" + profile.email}><span set:html={ic(icon.mail)}></span> {profile.email}</a>
    </div>
  </div>
</section>

<script>
  const el = document.querySelector("[data-roles]");
  if (el) {
    const roles = JSON.parse(el.getAttribute("data-roles") || "[]");
    const span = document.createElement("span");
    el.appendChild(span);
    const caret = document.createElement("span");
    caret.className = "caret";
    caret.textContent = "_";
    el.appendChild(caret);
    let r = 0, c = 0, del = false;
    const tick = () => {
      const word = roles[r];
      if (!del) {
        c++;
        span.textContent = word.slice(0, c);
        if (c === word.length) { del = true; return setTimeout(tick, 1600); }
        setTimeout(tick, 70);
      } else {
        c--;
        span.textContent = word.slice(0, c);
        if (c === 0) { del = false; r = (r + 1) % roles.length; return setTimeout(tick, 350); }
        setTimeout(tick, 35);
      }
    };
    setTimeout(tick, 300);
  }
</script>
