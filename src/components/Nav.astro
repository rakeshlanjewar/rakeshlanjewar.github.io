---
const sections = [
  { href: "#about", label: "About" },
  { href: "#skills", label: "Skills" },
  { href: "#projects", label: "Projects" },
  { href: "#experience", label: "Experience" },
  { href: "#education", label: "Education" },
  { href: "#contact", label: "Contact" },
];
// Astro.url.pathname may carry a trailing slash (e.g. "/light/"), so normalize.
const current = Astro.url.pathname.replace(/\/+$/, "") || "/";
const dest = current === "/light" ? "/" : "/light";
const swap = current === "/light" ? "Dark theme" : "Light theme";
---

<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="/">
      <span class="dot"></span> Rakesh Lanjewar
    </a>
    <nav class="nav-links" id="nav-links">
      {sections.map((s) => <a href={s.href}>{s.label}</a>)}
    </nav>
    <div class="nav-actions">
      <a class="toggle" href={dest} title={"See " + swap} aria-label={"Switch to " + swap}>
        <span class="knob"></span>
      </a>
      <button class="menu-btn" id="menu-btn" aria-label="Menu" aria-expanded="false">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </div>
</header>
