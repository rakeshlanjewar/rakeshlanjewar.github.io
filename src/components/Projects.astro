---
import { projects } from "../data/site";
const arrow = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M9 7h8v8"/></svg>';
---

<section id="projects" class="sec">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <span class="sec-num">03.</span><h2>Selected projects</h2><div class="rule"></div>
    </div>
    <div class="proj-grid">
      {projects.map((p) => (
        <article class="proj" data-reveal>
          <div class="proj-top">
            <span class="tag">{p.tag}</span><span class="org">{p.org}</span>
          </div>
          <h3>{p.name}</h3>
          <p>{p.description}</p>
          <div class="stack">{p.stack.map((s) => <span>{s}</span>)}</div>
        </article>
      ))}
    </div>
  </div>
</section>
